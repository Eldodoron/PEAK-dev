{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "bf_bossesrise:bite_debris",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/blocks/wool_colored_white"
			}
		},
		"events": {
			"dust": {
				"particle_effect": {
					"effect": "block_factorys_bosses:bite_dust",
					"type": "emitter"
				}
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 128,
				"max_particles": 32
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_lifetime_events": {
				"creation_event": "dust"
			},
			"minecraft:emitter_shape_box": {
				"offset": [0, 0.5, 0],
				"half_dimensions": [4, 0, 3],
				"direction": ["math.random(-1,1)", 1, "math.random(-1,1)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "4+v.particle_random_2"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-5,5)"
			},
			"minecraft:particle_initial_speed": "3+v.particle_random_2*12",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -25, 0],
				"linear_drag_coefficient": 2
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.5, 0.5],
				"facing_camera_mode": "direction_z",
				"direction": {
					"mode": "derive_from_velocity",
					"min_speed_threshold": 4
				},
				"uv": {
					"texture_width": 64,
					"texture_height": 16,
					"uv": ["math.round(v.particle_random_2*3)*16", 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 4,
				"collision_radius": 0.1
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00FFFFFF",
						"0.08": "#ffffffff",
						"0.87": "#ffffffff",
						"1.0": "#00FFFFFF"
					}
				}
			}
		}
	}
}