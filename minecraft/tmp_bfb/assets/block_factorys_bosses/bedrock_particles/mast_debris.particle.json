				"particle_effect": {
					"effect": "block_factorys_bosses:mast_dust",
					"type": "emitter"
				}
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 128,
				"max_particles": 12
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_lifetime_events": {
				"creation_event": "dust"
			},
			"minecraft:emitter_shape_box": {
				"offset": [0, 3, 0],
				"half_dimensions": [1, 3, 1],
				"direction": ["math.random(-1,1)", 1, "math.random(-1,1)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "4+v.particle_random_2"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-22,22)",
				"rotation_rate": "math.random(-20,20)"
			},
			"minecraft:particle_initial_speed": 6,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -25, 0],
				"linear_drag_coefficient": 1,
				"rotation_drag_coefficient": 2
			},
			"minecraft:particle_appearance_billboard": {
				"size": [1, 1],
				"facing_camera_mode": "direction_y",
				"direction": {
					"mode": "derive_from_velocity",
					"min_speed_threshold": 7
				},
				"uv": {
					"texture_width": 160,
					"texture_height": 32,
					"uv": ["math.round(v.particle_random_2*4)*32", 0],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 8,
				"collision_radius": 0.3
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00FFFFFF",
						"0.02": "#ffffffff",
						"0.87": "#ffffffff",
						"1.0": "#00FFFFFF"
					}
				}
			}
