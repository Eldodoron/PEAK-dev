	quest.2001000000000017.quest_subtitle: "Extended frontal reach to control aggressive beasts."
	quest.2001000000000017.title: "&bSpear — The Distance Keeper&r"
	quest.2001000000000018.quest_desc: [
		"&b• Heavy war pike providing unmatched reach advantage.&r"
		"&7Strike before the enemy can even enter combat range."
