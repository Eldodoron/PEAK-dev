	quest.5101000000000803.quest_desc: [
		"&e&lPull Up a Chair by the Fire.&r"
		""
		"Nothing beats a hot bowl of stew after freezing in a blizzard."
		"Simmer rich bone broths, toss al-dente spaghetti, and bake artisan casseroles."
		""
		"&6Tavern Keeper's Secret:&r &oLeave the soup pot simmering overnight for maximum richness.&r"
	]
	quest.5101000000000803.quest_subtitle: "Steaming stews, rich noodle broths, and hand-rolled pasta plates."
