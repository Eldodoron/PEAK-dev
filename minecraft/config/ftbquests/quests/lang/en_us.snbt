	quest.2001000000000025.quest_subtitle: "Thrown razor disc that bounces between enemies and returns."
	quest.2001000000000025.title: "&eChakram — The Returning Ring&r"
	quest.2001000000000099.quest_desc: [
		"&6&lA true weaponmaster knows every blade by feel.&r"
		""
		"You have forged and registered all 25 melee archetypes."
		"Your understanding of combat cadence is complete."
		""
		"&7Take this master smithing cache as your tribute.&r"
	]
	quest.2001000000000099.quest_subtitle: "You have crafted every iron weapon archetype in existence."
	quest.2001000000000099.title: "&6🏆 Master of the 25 Archetypes&r"
	quest.2002000000000000.quest_desc: [
		"&5&lThese are not forged at any mortal anvil.&r"
		""
		"Every weapon in this collection is a &cunique legendary relic.&r"
		"They drop exclusively in &bhigh-tier dungeon chests, dragon caves, and boss vaults.&r"
		""
		"&e• 100% Optional Collection and Achievements&r"
		"&a• Register any relic into your inventory to complete its entry.&r"
	]
	quest.2002000000000000.quest_subtitle: "49 Ancestral blades lost to the ages. Hunt them down."
	quest.2002000000000000.title: "&5🔮 Simply Swords — Mythic Relics&r"
	quest.2002000000000001.quest_desc: [
		"&c• Accumulates combat heat to regenerate wielder health over time.&r"
		"&6The longer the battle lasts, the more invincible you become."
		"&7Found in: Fire Dragon Caves and Nether Vaults."
	]
	quest.2002000000000001.quest_subtitle: "Warms the wielder, burns the enemy."
	quest.2002000000000001.title: "&6Hearthflame&r"
	quest.2002000000000002.quest_desc: [
		"&c• Detonates magma eruptions from beneath the earth with every heavy swing.&r"
		"&7Turns the battlefield into a field of boiling brimstone."
		"&7Found in: Nether Fortresses and Bastion Remnants."
	]
	quest.2002000000000002.quest_subtitle: "Subterranean volcanic eruptions on strike."
	quest.2002000000000002.title: "&cBrimstone Claymore&r"
	quest.2002000000000003.quest_desc: [
		"&e• Summons concentrated beams of pure solar radiance on hit.&r"
		"&6Deals astronomical sacred bonus damage against undead foes."
		"&7Found in: Sun Temples and Desert Pharaoh Vaults."
	]
	quest.2002000000000003.quest_subtitle: "Pure solar beams and sacred wrath."
	quest.2002000000000003.title: "&eSunfire&r"
	quest.2002000000000004.quest_desc: [
		"&c• Unfurls spinning vortexes of razor fire as you chain attacks.&r"
		"&7Traps surrounding enemies in an inescapable cyclone of embers."
		"&7Found in: Nether Dungeon Vaults."
	]
	quest.2002000000000004.quest_subtitle: "Razor-sharp fire cyclones on combo chains."
	quest.2002000000000004.title: "&cFlamewind&r"
	quest.2002000000000005.quest_desc: [
		"&c• Coats struck enemies in liquid magma, stripping their armor rating.&r"
		"&7Even Netherite plates melt under sustained heat."
		"&7Found in: Magma Caves and Fire Dragon Lairs."
	]
	quest.2002000000000005.quest_subtitle: "Melts enemy armor with superheated lava."
	quest.2002000000000005.title: "&6Molten Edge&r"
	quest.2002000000000006.quest_desc: [
		"&c• Superheated thrust attacks that bypass target armor completely.&r"
		"&7No armor, shield, or barrier can halt this needle."
		"&7Found in: Nether Strongholds."
	]
	quest.2002000000000006.quest_subtitle: "Blazing rapier thrust that pierces all defenses."
	quest.2002000000000006.title: "&cWickpiercer&r"
	quest.2002000000000007.quest_desc: [
		"&c• Sprays blazing ember sparks across all nearby hostiles on impact.&r"
		"&7Simple, scalding, and exceptionally reliable."
		"&7Found in: Nether Vaults and Lost Castles."
	]
	quest.2002000000000007.quest_subtitle: "Ignites everything it touches with burning embers."
	quest.2002000000000007.title: "&6Emberblade&r"
	quest.2002000000000008.quest_desc: [
		"&c• Whip-like flame strikes that scatter persistent trails of fire.&r"
		"&7Deny terrain and burn incoming waves."
		"&7Found in: Fire Dragon Caverns."
	]
	quest.2002000000000008.quest_subtitle: "Leaves glowing ash where enemies once stood."
	quest.2002000000000008.title: "&cEmberlash&r"
	quest.2002000000000009.quest_desc: [
		"&b• Calls down piercing stalactites of glacial ice from above.&r"
		"&7Slows and chills everything caught in the drop zone."
		"&7Found in: Ice Dragon Caves and Frost Dungeons."
	]
	quest.2002000000000009.quest_subtitle: "Rains sharp glacial spikes from the sky."
	quest.2002000000000009.title: "&bFrostfall&r"
	quest.200200000000000A.quest_desc: [
		"&b• Stacks intense frost on every hit until targets are frozen solid.&r"
		"&7Frozen targets cannot move, attack, or defend."
		"&7Found in: Deep Frozen Ocean Caves and Ice Lairs."
	]
	quest.200200000000000A.quest_subtitle: "Progressive deep freezing until total paralysis."
	quest.200200000000000A.title: "&bIcewhisper&r"
	quest.200200000000000B.quest_desc: [
		"&e• Discharges violent arcs of chain lightning between nearby hostiles.&r"
		"&7One hit electrifies the entire room."
		"&7Found in: Lightning Dragon Caves and Sky Temples."
	]
	quest.200200000000000B.quest_subtitle: "Chain lightning arcing across entire packs."
	quest.200200000000000B.title: "&eStormbringer&r"
	quest.200200000000000C.quest_desc: [
		"&e• Gathers kinetic electrical charges with every swing.&r"
		"&eIncreases attack speed progressively until the world moves in slow motion."
		"&7Found in: Lightning Dragon Nests."
	]
	quest.200200000000000C.quest_subtitle: "Electric aura that supercharges attack speed."
	quest.200200000000000C.title: "&eStorm's Edge&r"
	quest.200200000000000D.quest_desc: [
		"&e• Inscribes thunder marks upon victims that detonate in high-voltage bursts.&r"
		"&7Stack three marks for maximum blast radius."
		"&7Found in: Ancient Strongholds."
	]
	quest.200200000000000D.quest_subtitle: "Thunder marks that detonate in thunderclaps."
