	quest.02A758FDC30D745D.quest_subtitle: "Not elegant. Extremely effective."
	quest.02A758FDC30D745D.title: "&cGreathammer — Pure Concussion&r"
	quest.06FEA522C7671F71.quest_desc: [
		"&e• Extended frontal reach to keep beasts and mobs at bay.&r"
		"&7They can't touch what they can't reach."
	]
	quest.06FEA522C7671F71.quest_subtitle: "Stab first. Ask questions never."
	quest.06FEA522C7671F71.title: "&eSpear — The Distance Keeper&r"
