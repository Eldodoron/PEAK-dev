	quest.5102000000000000.quest_desc: [
		"&5&lWelcome to the Interdimensional Buffet!&r"
		""
		"Divided into 4 distinct otherworldly quadrants:"
		""
		"&c🔥 North-West:&r The Nether Smorgasbord (Lava-seared hoglins and ghast dough)"
		"&a🌲 North-East:&r The Twilight Forest Feast and 12-Rack Jerky Smoker"
		"&8🍄 South-West:&r The Undergarden Cavern Kitchen (Deep roots and gwiblings)"
		"&d🌌 South-East:&r The Outer End and Dark Depths (Chorus pies and angler fish)"
		""
		"&6Tip:&r &oEach dimension offers foods with unique permanent dietary health tags!&r"
	]
