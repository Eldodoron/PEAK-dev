	quest.09097077C3E95313.quest_subtitle: "Parry, lunge, finish."
	quest.09097077C3E95313.title: "&eRapier — The Duelist's Blade&r"
	quest.0CA57F240FE784F2.quest_desc: [
		"&e• Dual crescent blades for devastating close-quarters combat.&r"
		"&7Compact. Lethal. Completely unique."
	]
	quest.0CA57F240FE784F2.quest_subtitle: "Two blades. One target. Zero survivors."
	quest.0CA57F240FE784F2.title: "&eDeerhorns — Twin Crescent Blades&r"
	quest.0E96759C1A91A54C.quest_desc: [
		"&e• War pike with the longest melee reach available.&r"
		"&7Keep them away. Far, far away."
	]
	quest.0E96759C1A91A54C.quest_subtitle: "If they can touch you, you're doing it wrong."
	quest.0E96759C1A91A54C.title: "&eGreatspear — Maximum Reach&r"
	quest.0EA96E87EFD98CA6.quest_desc: [
		"&e• Reverse grip enables rapid combo chains while moving.&r"
		"&7Aggression is rewarded."
	]
	quest.0EA96E87EFD98CA6.quest_subtitle: "Devastating on aggressive mobile fighters."
	quest.0EA96E87EFD98CA6.title: "&eBackhand Blade — Reverse Grip&r"
	quest.1000000000000001.quest_desc: [
		"&6&lWelcome to PEAK.&r"
		""
		"No railroads. No forced path. &aExplore what you want, when you want.&r"
		""
		"This quest book is your &bmap, not your boss.&r Use it to discover mechanics, grab loot, and learn the secrets of this world."
		""
		"&7Grab your starter kit and let's get moving.&r"
	]
	quest.1000000000000001.quest_subtitle: "No quest lines. No hand-holding. Just vibes."
	quest.1000000000000001.title: "&6Welcome to PEAK!&r"
	quest.1000000000000002.quest_desc: [
		"&6&lYou are not the hero here. Yet.&r"
		""
		"&cMobs scale with your distance from spawn.&r The further you roam, the nastier they get."
		""
		"&e• Attack timing matters.&r Spam-clicking won't cut it."
		"&e• Two-handed weapons&r hit hard but leave you open."
		"&e• Watch the level bar&r above enemy heads — it's a threat meter."
		""
		"&7Respect the levels. Learn the patterns. Don't rush.&r"
	]
	quest.1000000000000002.quest_subtitle: "Mobs near spawn are kittens. Far away? Demons."
	quest.1000000000000002.title: "&cHeavy Combat and Scaling Difficulty&r"
	quest.1000000000000003.quest_desc: [
		"&c&lDon't mine Waystones with a wood pickaxe.&r Please."
		""
		"&6Two ways to move a Waystone safely:&r"
		""
		"&a1.&r &bDiamond Pickaxe or better&r — mine it normally."
		"&a2.&r &6Create Wrench&r — &lShift + Right Click&r picks it up &linstantly.&r"
		""
		"&7Here's a Wrench. You're welcome.&r"
	]
	quest.1000000000000003.quest_subtitle: "Shift + Right Click = free Waystone. You're a genius."
	quest.1000000000000003.title: "&eWaystones: The Truth&r"
	quest.1000000000000004.quest_desc: [
		"&6&lEvery chest is yours alone.&r No racing your friends to loot."
		""
		"Vanilla chest loot has been &crebalanced&r — you won't find free overpowered gear on day 1."
		""
		"&bMythic Weapons&r (Simply Swords and Bows) are rare. Very rare."
		""
		"&e• 0.1% chance&r in any non-vanilla chest."
		"&e• 5% chance&r in dragon caves, boss rooms and treasure vaults."
		""
		"&7Explore deeper. Loot smarter.&r"
	]
	quest.1000000000000004.quest_subtitle: "Your chest. Your loot. Go find the good stuff."
	quest.1000000000000004.title: "&bLoot and Mythic Weapons&r"
	quest.1000000000000005.quest_desc: [
		"&6&lHold SPACE in the air.&r You're flying now (sort of)."
		""
		"The Paraglider uses your &bstamina wheel.&r When it empties — down you go."
		""
		"Find &aGoddess Statues&r in villages. Trade &dSpirit Orbs&r for:"
		"&e• Heart Containers&r — more max health"
		"&e• Stamina Vessels&r — longer glide time"
		""
		"&7Your first Paraglider is on us.&r"
	]
	quest.1000000000000005.quest_subtitle: "Don't run. Fly. (Until the stamina runs out.)"
	quest.1000000000000005.title: "&aParaglider and Stamina&r"
	quest.1000000000000006.quest_desc: [
		"&6&lPress [B] to open your backpack instantly.&r No dropping it."
		""
		"Equip it in your &bCurios back slot&r and upgrade it endlessly:"
		""
		"&e• Magnet&r — pulls nearby items"
		"&e• Auto-Feed&r — eats for you"
		"&e• Filter&r — sorts what goes in"
		"&e• Stack Upgrade&r — holds way more"
		""
		"&7Your starter Backpack and Upgrade Base are on us.&r"
	]
	quest.1000000000000006.quest_subtitle: "A backpack with upgrades beats a second chest every time."
	quest.1000000000000006.title: "&6Backpacks and Upgrades&r"
	quest.1000000000000007.quest_desc: [
		"&6&lClaim chunks. Stop creeper grief.&r"
		""
		"Open your map or press &e[M]&r:"
		"&a• Left Click&r a chunk = Claim it (explosion-proof!)"
		"&a• Shift + Left Click&r a claimed chunk = Force-load it"
		""
		"&bForce-loading&r keeps your machines running while you're away."
		""
		"&7Play with friends? Use &e/ftbteams party create [name]&r to share progress.&r"
	]
	quest.1000000000000007.quest_subtitle: "No chunk claimed = creeper playground."
	quest.1000000000000007.title: "&eChunks, Teams and Territory&r"
	quest.1000000000000008.quest_desc: [
		"&6&lMaster these. Save 10 minutes a day.&r"
		""
		"&e[R]&r on any item = See its recipe in JEI"
		"&e[U]&r on any item = See where it is used"
		"&e[A]&r on any item = Bookmark it on the side"
		"&e[B]&r = Open equipped backpack"
		"&e[M]&r = Open map and claim chunks"
		""
		"&7You're ready. Go explore and build!&r"
	]
	quest.1000000000000008.quest_subtitle: "Shortcuts are the real endgame."
	quest.1000000000000008.title: "&bKeybinds and JEI Tricks&r"
	quest.2000000000000001.quest_desc: [
		"&5&lWelcome to the PEAK Armory.&r"
		""
		"In this world, weapons are not boring stat sticks with flat numbers."
		"Every single &earchetype&r possesses its own distinct &bcombat rhythm, cadence, and reach.&r"
		""
		"&6• Mortal Weapons&r can be forged at an anvil with standard iron or dimensional alloys (Cataclysm, Dragons, Twilight, Undergarden)."
		"&d• Mythic Relics and Elemental Bows&r are lost ancient treasures sleeping in &cdeadly dungeons and boss lairs.&r"
		""
		"&7Choose your weapon. Master your style.&r"
	]
	quest.2000000000000001.quest_subtitle: "Mortal steel, otherworldly alloys, and ancestral relics."
	quest.2000000000000001.title: "&5🌟 The Awakening of Mythic Armaments&r"
	quest.2001000000000000.quest_desc: [
		"&6&l25 Archetypes. Infinite combat combinations.&r"
		""
		"Divided into 4 combat categories:"
		"&e• Light and Swift Blades&r — rapid combos, parries, backstabs"
		"&a• Balanced and Versatile&r — sweeps, guard breaks, crowd control"
		"&c• Heavy and Concussive&r — shield-shattering titanic strikes"
		"&b• Polearms and Thrown Melee&r — extended reach and ranged melee"
		""
		"&7Craft the iron variant of each weapon to register it in your codex.&r"
	]
	quest.2001000000000000.quest_subtitle: "Every weapon has its own fighting style. Craft them all."
	quest.2001000000000000.title: "&6⚔️ The Forge — 25 Weapon Archetypes&r"
	quest.2001000000000001.quest_desc: [
		"&e• Lightning-fast parrying weapon with rapid close-quarters counter timing.&r"
		"&7Nullifies incoming strikes and retaliates in milliseconds."
	]
	quest.2001000000000001.quest_subtitle: "Ultra-fast close-range parrying weapon."
	quest.2001000000000001.title: "&eSai — The Parrying Fang&r"
	quest.2001000000000002.quest_desc: [
		"&e• Ultra-high attack speed. Short reach, zero mercy.&r"
		"&cDeals massive critical damage when striking enemies from behind."
	]
	quest.2001000000000002.quest_subtitle: "High cadence with deadly backstab multipliers."
	quest.2001000000000002.title: "&eDagger — Backstabber's Fang&r"
	quest.2001000000000003.quest_desc: [
		"&e• Piercing thrust attack that bypasses defensive armor layers entirely.&r"
		"&7The ultimate weapon for precision 1v1 combat."
	]
	quest.2001000000000003.quest_subtitle: "Armor-piercing frontal thrusts."
	quest.2001000000000003.title: "&eRapier — Duelist's Needle&r"
