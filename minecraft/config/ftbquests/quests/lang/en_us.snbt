	quest.5105000000000801.quest_desc: [
		"&2&lFlavors from the Dawn of Time.&r"
		""
		"Cook golden dinosaur nuggets, brew thick primordial soups, and braise crunchy trilocaris tails."
		""
		"&6Paleontologist's Note:&r &oYes, the dinosaur nuggets are shaped like actual dinosaurs!&r"
	]
	quest.5105000000000801.quest_subtitle: "Where dinosaurs roam and ancient pine nuts roast over magma vents."
	quest.5105000000000801.title: "&2🦖 Primordial Caves and Ancient Stews&r"
	quest.5105000000000802.quest_desc: [
		"&d&lA Confectionery Dreamland.&r"
		""
		"Indulge in ice cream sundaes, fizzy purple sodas, five colors of gummy fish,"
		"and sharpened candy cane toothpicks."
		""
		"&6Dentist's Warning:&r &oBrush your teeth after this quadrant or face severe cavities!&r"
	]
	quest.5105000000000802.quest_subtitle: "Mountains of sugar crystals, hot chocolate geysers, and fizzy grape sodas."
	quest.5105000000000802.title: "&d🍭 The Candy Cavity and Soda Bar&r"
	quest.5105000000000803.quest_desc: [
		"&6&lThe Wild Australian Bush Barbecue.&r"
		""
		"Fire up the grill for juicy kangaroo burgers, braised shanks, and barbecue moose racks."
		""
		"&6Grillmaster's Tip:&r &oKangaroo meat is ultra-lean — do not overcook it!&r"
	]
	quest.5105000000000803.quest_subtitle: "Kangaroo burgers, slow-smoked moose ribs, and giant boiled emu eggs."
	quest.5105000000000803.title: "&6🦘 The Outback Safari and Bush Tavern&r"
	quest.5105000000000804.quest_desc: [
		"&3&lThe Midnight Zone of the Ocean Floor.&r"
		""
		"Dive into crushing depths to harvest glowing lanternfish, deep-sea mussels, and tripodfish."
		""
		"&6Submariner's Secret:&r &oDeep Sea Sushi Rolls grant glowing vision in pitch-black waters!&r"
	]
	quest.5105000000000804.quest_subtitle: "Bioluminescent lanternfish, radioactive radgills, and abyssal sushi rolls."
	quest.5105000000000804.title: "&3🤿 Abyssal Trenches and Deep Sea Sushi&r"
	quest.5105000000000999.quest_desc: [
		"&2&lThe Undisputed Master of the Wild Frontier!&r"
		""
		"From the golden dinosaur nuggets of the &aPrimordial Caves&r to the sugar rush of the &dCandy Cavity&r,"
		"the kangaroo feasts of the &6Outback&r, and the glowing sushi of the &3Abyssal Depths&r,"
		"you have conquered every creature and confection in the natural and prehistoric world."
		""
		"&6Enjoy your Master Chef tribute and Grandmaster Feast Hamper!&r"
	]
	quest.5105000000000999.quest_subtitle: "You have hunted, gathered, and tasted all 70 prehistoric, candy, and safari delicacies!"
	quest.5105000000000999.title: "&2🏆 Master of the Safari and Cave Explorer&r"
